# Copia este archivo como .env (raíz de GH-BUS) y completa los valores.
# El archivo .env NUNCA se sube a GitHub.
# Los secretos vacíos son obligatorios: docker compose no arranca sin ellos.
# Genera cada uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# --- MySQL ---
MYSQL_ROOT_PASSWORD=cambia_esta_clave_root
MYSQL_DATABASE=ghbus
MYSQL_USER=ghbus_user
MYSQL_PASSWORD=cambia_esta_clave_app
MYSQL_HOST_PORT=3306

# --- Backend Django ---
DJANGO_SECRET_KEY=
DEBUG=False
# Mantén "localhost": el health check del contenedor lo necesita.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080
GUNICORN_WORKERS=3

# --- Seguridad entre servicios (mínimo 32 caracteres, distintos entre sí) ---
JWT_SIGNING_KEY=
REALTIME_HMAC_SECRET=

# --- Acceso desde el navegador ---
WEB_PORT=8080

# Correo (recuperación de contraseña). Por defecto los correos salen en la consola del contenedor
# (docker compose logs backend). Para enviarlos de verdad usa SMTP:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend y completa EMAIL_HOST/USER/PASSWORD.
# NUNCA subas credenciales SMTP a GitHub.
FRONTEND_URL=http://localhost:8080
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=GH BUS <no-responder@ghbus.local>
# Pon True solo cuando sirvas el sitio por HTTPS
AUTH_COOKIE_SECURE=False
