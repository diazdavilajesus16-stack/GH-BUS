# Copia este archivo como backend/.env. NUNCA se sube a GitHub.
# Genera la clave secreta con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (deben coincidir con el .env de la raíz)
DB_ENGINE=mysql
DB_NAME=ghbus
DB_USER=ghbus_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Clave para firmar los JWT (mínimo 32 caracteres, distinta de DJANGO_SECRET_KEY).
# Debe ser IGUAL a JWT_SIGNING_KEY de realtime/.env
JWT_SIGNING_KEY=

# Asistente de viajes (opcional). No compartas la clave ni la subas a GitHub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Servicio de tiempo real (Node.js). Vacío = no se publican eventos.
# REALTIME_HMAC_SECRET debe ser IGUAL al de realtime/.env (mínimo 32 caracteres)
REALTIME_URL=http://localhost:4000
REALTIME_HMAC_SECRET=

# Frontend autorizado (Vite)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=

# Correo (recuperación de contraseña). Por defecto los correos salen en la consola del contenedor
# (docker compose logs backend). Para enviarlos de verdad usa SMTP:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend y completa EMAIL_HOST/USER/PASSWORD.
# NUNCA subas credenciales SMTP a GitHub.
FRONTEND_URL=http://localhost:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=GH BUS <no-responder@ghbus.local>
# Pon True solo cuando sirvas el sitio por HTTPS
AUTH_COOKIE_SECURE=False
# Solo detrás de un proxy (nginx). En desarrollo local déjalo en False.
USE_PROXY_HEADERS=False
