# Copia este archivo como backend/.env. NUNCA se sube a GitHub.
# Genera la clave secreta con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (deben coincidir con el .env de la raíz)
DB_ENGINE=mysql
DB_NAME=ghbus
DB_USER=ghbus_user
DB_PASSWORD=cambia_esta_clave_app
DB_HOST=127.0.0.1
DB_PORT=3306

# Clave para firmar los JWT (mínimo 32 caracteres, distinta de DJANGO_SECRET_KEY).
# Debe ser IGUAL a JWT_SIGNING_KEY de realtime/.env
JWT_SIGNING_KEY=

# Servicio de tiempo real (Node.js). Vacío = no se publican eventos.
# REALTIME_HMAC_SECRET debe ser IGUAL al de realtime/.env (mínimo 32 caracteres)
REALTIME_URL=http://localhost:4000
REALTIME_HMAC_SECRET=

# Frontend autorizado (Vite)
CORS_ALLOWED_ORIGINS=http://localhost:5173
